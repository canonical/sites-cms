# Copy to .env to override a local default. Every value here is already the
# default, so the project runs without a .env file.

# Port the database container listens on (see docker-compose.yml).
# If you change it, change DATABASE_URL to match.
DB_PORT=5434
DATABASE_URL=postgresql://sites_cms:sites_cms@localhost:5434/sites_cms

# Production only. Listed here so every variable is documented in one place.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=cms.example.com
# DJANGO_BASE_URL=https://cms.example.com
# POSTGRESQL_DB_CONNECT_STRING=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# SENTRY_DSN=
# COMMIT_ID=
